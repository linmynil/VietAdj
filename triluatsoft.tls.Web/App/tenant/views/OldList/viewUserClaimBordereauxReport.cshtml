<div ng-controller="tenant.views.OldList.viewUserClaimBordereauxReport as vm">
    <div class="row margin-bottom-5">
        <div class="col-xs-6">
            <div class="page-head">
                <div class="page-title">
                    <h1>
                        <span>@L("ClaimBordereauxReport")</span>
                    </h1>
                </div>
            </div>
        </div>

    </div>
    <div class="portlet light margin-bottom-0">
        <div class="portlet-body">
            <form action="#" class="form-horizontal" busy-if="vm.loading" name="form" novalidate>
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("DateRange")
                                </label>
                                <div class="col-md-4">
                                    <input date-range-picker type="text" options="vm.dateRangeOptions" min="vm.dateRangeOptions.min" max="vm.dateRangeOptions.max" class="form-control date-picker input-large" ng-model="vm.dateRangeModel" />

                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("Status")
                                </label>
                                <div class="col-md-4">
                                    <select class="form-control input-large"
                                            ng-model="vm.searchdata.statusID">
                                        <option selected="selected" value="">All</option>
                                        <option value="1">Outstanding</option>
                                        <option value="2">Closed</option>
                                        <option value="3">Re-opened</option>

                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("Office")
                                </label>
                                <div class="col-md-4">
                                    <select class="form-control input-large"
                                            ng-model="vm.searchdata.officeID">
                                        <option selected="selected" value="">All</option>
                                        <option value="1">SG</option>
                                        <option value="2">HN</option>

                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-actions" style="text-align:center;">
                                <button type="submit" class="btn btn-primary blue" ng-click="vm.exportClaim($event)">
                                    Export
                                </button>
                            </div>
                        </div>                        
                    </div>
                    <div class="row">
                        <div class="col-md-12"><hr /></div>
                    </div>
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group" ng-class="{ 'has-error' : form.insurer.$invalid}">
                                <label class="control-label col-md-2">
                                    @L("Insurer")
                                </label>
                                <div class="col-md-10">

                                    <select class="form-control" required name="insurer"
                                            ng-model="vm.insurerID" ng-options="opt.id as opt.name for opt in vm.listInsureres">
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("Language")
                                </label>
                                <div class="col-md-8">
                                    <select class="form-control input-small" ng-model="vm.lang" ng-init="vm.lang='EN'" required>
                                        <option value="EN">English</option>
                                        <option value="VN">Vietnamese</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <div class="row">
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary blue"
                                    ng-disabled="form.$invalid"
                                    ng-click="vm.printReport($event, 'inline')">
                                @L("ViewReport")
                            </button>
                        </div>
                    </div>
                </div>
            </form>
            <br />

            <div class="row">
                <div class="col-md-12" style="margin-left:5%">
                    <iframe id="ReportFrame" src="" width="100%" height="1000" style="border:none"></iframe>
                </div>
            </div>
        </div>
    </div>

    <script>
    </script>
