<div>
    <form name="form" role="form" class="form-validation">
        <div class="panel-group">
            <div class="modal-header">
                <button type="button" class="close" ng-click="vm.cancel()">&times;</button>
                <h3 style="color:#0285bd">@L("InvoicePayment")</h3>
            </div>
            <div class="modal-body">
                <table id="datatable" class="table table-striped table-bordered dataTable no-footer" >
                    <thead>
                        <tr>
                            <th class="text-center col-md-1">@L("ClaimRef")</th>
                            <!--<th class="text-center col-md-3">@L("PaymentNo")</th>-->
                            <th class="text-center col-md-2">@L("Date")</th>
                            <th class="text-center col-md-1">@L("InvoiceNo")</th>
                            <th class="text-center col-md-3">@L("Insurer")</th>
                            <th class="text-center col-md-2">@L("PaidAmount")</th>
                            <th class="text-center col-md-1">@L("PaymentMethod")</th>
                        </tr>

                    </thead>
                        <tr ng-repeat="item in vm.list">
                            <td class="text-left">{{item.claimID}}</td>
                            <!--<td class="text-left">{{item.paymentCode}}</td>-->
                            <td class="text-center">{{item.paymentDate | date: 'dd-MM-yyyy'}}</td>
                            <td class="text-right">{{item.invoiceCode}}</td>
                            <td class="text-left">{{item.customerName}}</td>
                            <td class="text-right">{{item.paymentAMT | number: 0}}</td>
                            <td class="text-center">{{item.paymentMethod}}</td>
                        </tr>
                    <tr ng-show="vm.list.length == 0">
                        <td colspan="15">@L("NoRecords")</td>
                    </tr>
                </table>

            </div>
            </div>

            <div class="modal-footer">
                <button ng-disabled="vm.saving" type="button" class="btn btn-default" ng-click="vm.cancel()">@L("Close")</button>
            </div>
        </form>
    </div>