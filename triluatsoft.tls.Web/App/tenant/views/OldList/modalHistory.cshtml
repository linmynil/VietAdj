<div>
    <form name="form" role="form" class="form-validation">
        <div class="panel-group">
            <div class="modal-header">
                <button type="button" class="close" ng-click="vm.cancel()">&times;</button>
                <h3 style="color:#0285bd">@L("History")</h3>
            </div>
            <div class="modal-body">
                <table class="table table-striped table-bordered table-hover no-footer" busy-if="vm.loading" data-click-to-select="true">
                    <thead role="row">
                        <tr>
                            <th class="text-center">@L("Description")</th>
                            <th class="text-center">@L("ModifiedDate")</th>
                            <th class="text-center">@L("VoucherDate")</th>
                            <th class="text-center">@L("ReferenceNo")</th>
                            <th class="text-center">@L("PaymentMethod")</th>
                            <th class="text-center">@L("VoucherType")</th>
                            <th class="text-center">@L("Amount")</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in vm.list">
                            <td class="text-left">{{item.description}}</td>
                            <td class="text-center">{{item.createdDate | date:'dd-MM-yyyy'}}</td>
                            <td class="text-center">{{item.inputDate | date:'dd-MM-yyyy'}}</td>
                            <td class="text-left">{{item.refNbr}}</td>
                            <td class="text-center">{{item.paymentMethodString}}</td>
                            <td class="text-center">{{item.voucherTypeString}}</td>
                            <td class="text-right">{{item.amount | number:0}}</td>
                        </tr>
                    </tbody>
                </table>
              
                </div>
            </div>

            <div class="modal-footer">
                <button ng-disabled="vm.saving" type="button" class="btn btn-default" ng-click="vm.cancel()">@L("Close")</button>
               
            </div>
        </form>
    </div>