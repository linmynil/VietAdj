<div>
    <form name="form" role="form" class="form-validation">
        <div class="panel-group">
            <div class="modal-header">
                <button type="button" class="close" ng-click="vm.cancel()">&times;</button>
                <h3 style="color:#0285bd">@L("TimesheetExpenese")</h3>
            </div>
            <div class="modal-body">
                <label>Timesheet: {{vm.timesheetName}}</label>
                <uib-tabset class="tab-container tabbable-line">
                    <uib-tab heading="@L("Fee")">
                        <a ng-click="vm.openModalAddFee()" title="@L("AddFee")"><i class="fa fa-plus" style="font-size:25px"></i></a>
                        <table id="datatable" class="table table-striped table-bordered table-hover table-checkable dataTable no-footer" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th class="text-center col-lg-2">@L("Date")</th>
                                    <th class="text-center">@L("Description")</th>
                                    <th class="text-center">@L("StandardTime")</th>
                                    <th class="text-center">@L("ActualTime")</th>
                                    <th class="text-center">@L("Rate")</th>
                                    <th class="text-center">@L("ActualFeeUSD")</th>
                                    <th class="text-center col-lg-2">@L("Actions")</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in vm.list">
                                    <td class="text-center">{{item.inputDate | date:'dd-MM-yyyy'}}</td>
                                    <td class="text-left">{{item.notes}}</td>
                                    <td class="text-right">{{item.standardTime | number:1}}</td>
                                    <td class="text-right">{{item.workTimeStr}}</td>
                                    <td class="text-right">{{item.feePerHour}}</td>
                                    <td class="text-right">{{item.proFeeValue}}</td>
                                    <td class="text-center">
                                        <button ng-click="vm.removeFee(item.professionalFeeID)" ng-disabled="!item.isOwner" title="@L("DeleteFee")" class="btn btn-circle btn-icon-only red delete-person" href="javascript:;">
                                            <i class="icon-trash"></i>
                                        </button>
                                        <button ng-click="vm.openModalAddFee(item)" ng-disabled="!item.isOwner" title="@L("EditFee")" class="btn btn-circle btn-icon-only blue delete-person" href="javascript:;" style="margin-right:0px">
                                            <i class="icon-pencil"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr ng-show="vm.list.length == 0">
                                    <td colspan="15">@L("NoRecords")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </uib-tab>
                    <uib-tab>
                        <uib-tab-heading>
                            @L("Expenses") <b class="badge badge-primary"></b>
                        </uib-tab-heading>
                        <a ng-click="vm.openModalExpenses()" title="@L("AddExpenses")"><i class="fa fa-plus" style="font-size:25px"></i></a>
                        <table id="datatable" class="table table-striped table-bordered table-hover table-checkable dataTable no-footer" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th class="text-center col-lg-2">@L("Date")</th>
                                    <th class="text-center">@L("Description")</th>
                                    <th class="text-center">@L("TypeOfExpense")</th>
                                    <th class="text-center">@L("Amount")</th>
                                    <th class="text-center col-lg-2">@L("Actions")</th>
                                </tr>
                            </thead>
                            <tr ng-repeat="item in vm.listExp">
                                <td class="text-center">{{item.inputDate | date:'dd-MM-yyyy'}}</td>
                                <td class="text-left">{{item.description}}</td>
                                <td class="text-left">{{item.expenseTypeName}}</td>
                                <td class="text-right">{{item.amount | number : 0}}</td>
                                <td class="text-center">
                                    <button ng-click="vm.removeEx(item.expenseID)" title="@L("DeleteExpenses")" class="btn btn-circle btn-icon-only red delete-person" href="javascript:;">
                                        <i class="icon-trash"></i>
                                    </button>
                                    <button ng-click="vm.openModalExpenses(item)" title="@L("EditExpenses")" class="btn btn-circle btn-icon-only blue delete-person" href="javascript:;" style="margin-right:0px">
                                        <i class="icon-pencil"></i>
                                    </button>
                                </td>
                            </tr>
                            <tfoot>
                                <tr ng-show="vm.listExp.length == 0">
                                    <td colspan="15">@L("NoRecords")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </uib-tab>
                </uib-tabset>
            </div>

            <div class="modal-footer">
                <button ng-disabled="vm.saving" type="button" class="btn btn-default" ng-click="vm.cancel()">@L("Close")</button>
            </div>
        </div>
    </form>
</div>
