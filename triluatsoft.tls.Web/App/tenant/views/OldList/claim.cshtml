<style>
    .table > thead > tr > th {
        vertical-align: middle;
    }
    .table > tbody > tr > td,
    .table > tbody > tr > th,
    .table > tfoot > tr > td,
    .table > tfoot > tr > th,
    .table > thead > tr > td,
    .table > thead > tr > th {
        vertical-align: middle;
    }
</style>
<div ng-controller="tenant.views.OldList.claim as vm">
    <div class="row margin-bottom-5">
        <div class="col-xs-6">
            <div class="page-head">
                <div class="page-title">
                    <h1>
                        <span>@L("ManageClaims")</span>
                    </h1>
                </div>
            </div>
        </div>
        <div class="col-xs-6 text-right">
            <button id="createbnt" class="btn btn-primary blue" onclick="location.href = 'Application#!/tenant/cu-claim';"><i class="fa fa-plus" href="cu-claim"></i>@L("Create")</button>
        </div>
    </div>
    <div class="portlet light margin-bottom-0">
        <div class="portlet-body">
            <form action="#" class="form-horizontal form-row-sepe ng-pristine ng-valid" busy-if="vm.loadingDate">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("DateRange")
                                </label>
                                <div class="col-md-4">
                                    <input date-range-picker  type="text" options="vm.dateRangeOptions" min="vm.dateRangeOptions.min" max="vm.dateRangeOptions.max" class="form-control date-picker input-large" ng-model="vm.dateRangeModel" />

                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3" for="accMan">
                                    @L("AccountManager")
                                </label>
                                <div class="col-md-4">
                                    <select class="form-control input-large" ng-model="vm.searchdata.accountManagerId" ng-options="emp.id as emp.name for emp in vm.listEmployees">
                                        <option selected value="">All</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("ClaimRef")
                                </label>
                                <div class="col-md-4">
                                    <input id ="search" type="text" data-provide="typeahead" class="form-control input-large" ng-model="vm.searchdata.claimRefId" maxlength="20">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("Status")
                                </label>
                                <div class="col-md-4">
                                    <select class="form-control input-large"
                                            ng-model="vm.searchdata.refStatusId">
                                        <option selected="selected" value="">All</option>
                                        <option value="1">Outstanding</option>
                                        <option value="2">Closed</option>
                                        <option value="3">Re-opened</option>

                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("Insurer")
                                </label>
                                <div class="col-md-4">
                                    <select class="form-control input-large"
                                            ng-model="vm.searchdata.insurerId" ng-options="opt.id as opt.brandName for opt in vm.listInsureres">
                                        <option selected value="">All</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("Office")
                                </label>
                                <div class="col-md-4">
                                    <select class="form-control input-large"
                                            ng-model="vm.searchdata.officeId">
                                        <option selected="selected" value="">All</option>
                                        <option value="1">SG</option>
                                        <option value="2">HN</option>

                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("Broker")
                                </label>
                                <div class="col-md-4">
                                    <select class="form-control input-large"
                                            ng-model="vm.searchdata.brokerId" ng-options="opt.id as opt.brandName for opt in vm.listBrokers">
                                        <option selected value="">All</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("PolicyNo")
                                </label>
                                <div class="col-md-4">
                                    <input type="text" class="form-control input-large" ng-model="vm.searchdata.policyNo" maxlength="100">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">

                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("TheInsured")
                                </label>
                                <div class="col-md-4">
                                    <input type="text" class="form-control input-large" ng-model="vm.searchdata.theInsured">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("TypeOfClaim")
                                </label>
                                <div class="col-md-4">
                                    <select class="form-control input-large"
                                            ng-model="vm.searchdata.claimTypeCode" ng-options="opt.code as opt.code for opt in vm.listClaimTypes">
                                        <option selected value="">All</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">

                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("TypeOfLoss")
                                </label>
                                <div class="col-md-4">
                                    <select class="form-control input-large"
                                            ng-model="vm.searchdata.typeOfLossId" ng-options="opt.id as opt.name for opt in vm.listTypeOfLoss">
                                        <option selected value="">All</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("CauseOfLoss")
                                </label>
                                <div class="col-md-4">
                                    <select class="form-control input-large"
                                            ng-model="vm.searchdata.causeId" ng-options="opt.id as opt.name for opt in vm.listCauses">
                                        <option selected value="">All</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <div class="row">
                        <div class="col-md-offset-5 col-md-9">
                            <button type="submit" ng-disabled="vm.loading || !vm.permissions.searchClaim" class="btn btn-primary blue" ng-click="vm.searchLogs($event)">
                                @L("Search")
                            </button>
                            <button type="reset" class="btn btn-primary blue" ng-click="vm.reset()">
                                @L("Reset")
                            </button>
                        </div>
                    </div>
                </div>
            </form>
            <br />
            <table class="table table-striped table-bordered table-hover no-footer" busy-if="vm.loading" data-click-to-select="true">
                <thead role="row">
                    <tr>
                        <th class="text-center col-md-1">@L("ClaimRef")</th>
                        <th class="text-center col-md-1">@L("Folder")</th>
                        <th class="text-center col-md-1">@L("Insurer")</th>
                        <th class="text-center">@L("Reserve")</th>
                        <th class="text-center">@L("AccountManager")</th>
                        <th class="text-center">@L("Office")</th>
                        <th class="text-center col-md-1">@L("Status")</th>
                        <th class="text-center col-md-1">@L("DateOfAssignment")</th>
                        <th class="text-center col-md-2">@L("Timesheet")</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="cause in vm.list">
                        <td class="text-center"><span ng-click="vm.redirectEdit(cause.id)"><a>{{cause.id}}</a></span></td>
                        <td class="text-center">
                            <button ng-click="vm.openModalFolder(cause.id)" title="@L("Folder")" class="btn btn-circle btn-icon-only blue" href="javascript:;">
                                <i class="icon-folder"></i>
                            </button>
                        </td>
                        <td class="text-center">{{::cause.insurerName}}</td>
                        <td class="text-right">{{::cause.reserve | number : 0}}</td>
                        <td class="text-center text-nowrap">{{::cause.accManName}}</td>
                        <td class="text-center">{{::cause.officeName}}</td>
                        <td class="text-center">{{::cause.refStatusName}}</td>
                        <td class="text-center">{{::cause.dateOfAssignment | date:'dd/MM/yyyy'}}</td>
                        <td class="text-center">
                            <button ng-click="vm.popupWindow(cause.id, 'EN')" class="btn btn-icon-only" href="javascript:;">
                                <i class="famfamfam-flag-gb"></i>
                            </button>
                            <button ng-click="vm.popupWindow(cause.id, 'VN')" class="btn btn-icon-only " href="javascript:;">
                                <i class="famfamfam-flag-vn"></i>
                            </button>
                        </td>
                        @*<td class="text-center">
                            <button ng-click="vm.openModal(cause)" title="@L("View")" class="btn btn-circle btn-icon-only blue" href="javascript:;">
                                <i class="icon-info"></i>
                            </button>
                            <button ng-click="vm.redirectEdit(cause.id)" title="@L("Edit")" class="btn btn-circle btn-icon-only blue" href="javascript:;">
                                <i class="icon-pencil"></i>
                            </button>
                        </td>*@
                    </tr>
                    <tr ng-show="vm.list.length == 0">
                        <td colspan="15">@L("NoRecords")</td>
                    </tr>
                </tbody>
            </table>
            <div class="row">
                <div class="col-md-7">
                    <ul boundary-link-numbers="true" class="margin-top-0" uib-pagination total-items="vm.totalCount" items-per-page="20" ng-model="vm.page" ng-change="vm.pageChanged()" max-size="5"></ul>
                </div>
            </div>
        </div>
    </div>
</div>