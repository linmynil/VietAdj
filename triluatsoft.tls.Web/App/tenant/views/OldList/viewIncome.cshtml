<div ng-controller="tenant.views.OldList.viewIncome as vm">
    <div class="row margin-bottom-5">
        <div class="col-xs-6">
            <div class="page-head">
                <div class="page-title">
                    <h1>
                        <span>@L("Income")</span>
                    </h1>
                </div>
            </div>
        </div>
        <div class="col-xs-6 text-right">
            <a class="btn btn-primary blue" ng-click="vm.openModal()"><i class="fa fa-plus"></i>@L("Create")</a>
        </div>
    </div>
    <div class="portlet light margin-bottom-0">
        <div class="portlet-body">
            <form action="#" class="form-horizontal form-row-sepe ng-pristine ng-valid" busy-if="vm.loadingDate">
                <div class="form-body">

                    <div class="row" style="padding-bottom:15px">
                        <span class="btn green fileinput-button">
                            <i class="fa fa-plus"></i>
                            <span>
                                @L("UploadFile")
                            </span>
                            @*<input type="file" ng-model="vm.fileUpload">*@
                            <input type="file" id="uploadFile" nv-file-select uploader="vm.uploader" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" class="form-control" ng-disabled="!vm.isAdmin"/>
                        </span>
                        <button type="submit" class="btn btn-primary blue" ng-click="vm.UploadFile($event)" ng-disabled="!vm.isAdmin">
                            @L("UploadIncome")
                        </button>                        
                    </div>
                    <!--
                    <div class="form-actions" style="padding-bottom:15px">
                        <div class="row">
                            <div class="col-md-9 pull-left">
                                <button class="btn btn-primary blue" >
                                    @L("UploadIncome")
                                </button>
                            </div>
                        </div>
                    </div>-->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("DateRange")
                                </label>
                                <div class="col-md-4">
                                    <input date-range-picker type="text" options="vm.dateRangeOptions" min="vm.dateRangeOptions.min" max="vm.dateRangeOptions.max" class="form-control date-picker input-large" ng-model="vm.dateRangeModel" />

                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("Type")
                                </label>
                                <div class="col-md-8">
                                    <select class="form-control" ng-model="vm.searchdata.cIncomeTypeID" ng-options="opt.id as opt.incomeName for opt in vm.typelist">
                                        <option selected value="">All</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("LossAdjusters")
                                </label>
                                <div class="col-md-8">
                                    <select class="form-control" ng-model="vm.searchdata.employeeID" ng-options="opt.employeeID as opt.name for opt in vm.listEmps">
                                        <option selected value="">All</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group" style="margin-bottom:0px">
                                <label class="col-md-3 control-label">@L("Contributed")</label>
                                <div class="col-md-9">
                                    <div class="mt-radio-inline">
                                        <label class="mt-radio">
                                            <input type="radio" name="optionsRadios1" id="optionsRadios1" ng-model="vm.searchdata.contribution" value="true">
                                            Yes
                                            <span></span>
                                        </label>
                                        <label class="mt-radio">
                                            <input type="radio" name="optionsRadios1" id="optionsRadios1" ng-model="vm.searchdata.contribution" value="false">
                                            No
                                            <span></span>
                                        </label>
                                        <label class="mt-radio">
                                            <input checked type="radio" spellcheck="true" name="optionsRadios1" ng-model="vm.searchdata.contribution" id="optionsRadios1" value="">
                                            All
                                            <span></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>                      
                    </div>
                </div>

                <div class="form-actions">
                    <div class="row">
                        <div class="col-md-offset-5 col-md-9">
                            <button type="submit" ng-disabled="vm.loading" class="btn btn-primary blue" ng-click="vm.searchLogs($event)">
                                @L("Search")
                            </button>
                        </div>
                    </div>
                </div>
            </form>
            <br />
            <table class="table table-striped table-bordered table-hover no-footer" busy-if="vm.loading" data-click-to-select="true">
                <thead role="row">
                    <tr>
                        <th class="text-center">@L("LossAdjusters")</th>
                        <th class="text-center">@L("Period")</th>
                        <th class="text-center">@L("Amount")</th>
                        <th class="text-center">@L("Type")</th>  
                        <th class="text-center">@L("Contributed")</th>
                        <th class="text-center">@L("Description")</th>
                        <th class="text-center" style="width:100px">@L("Actions")</th>
                    </tr>
                    
                    <tr ng-repeat="item in vm.incomeList.slice(((vm.currentPage-1)*vm.itemsPerPage), ((vm.currentPage)*vm.itemsPerPage))">
                        <td class="text-center">{{item.employeeName}}</td>
                        <td class="text-center">{{item.date | date: 'dd/MM/yyyy'}}</td>
                        <td class="text-center">{{item.incomeAMT | number:0}}</td>
                        <td class="text-center">{{item.incomeName}}</td>
                        <td class="text-center"><i class="fa fa-2x" ng-class="item.contribution?'fa-check text-success':'fa-ban text-danger'"></i></td>
                        <!--<td class="text-center">{{item.contribution}}</td>-->
                        <td class="text-center">{{item.description}}</td>
                        <td class="text-center">
                            <button ng-click="vm.openModal(item, 'edit')" title="@L("Edit")" class="btn btn-circle btn-icon-only blue" href="javascript:;" style="margin-left:0px;margin-right:0px">
                                <i class="icon-pencil"></i>
                            </button>
                            <button ng-click="vm.deleteIncome(item.id)" title="@L("Delete")" class="btn btn-circle btn-icon-only red delete-person" href="javascript:;" style="margin-right:0px;margin-left:0px">
                                <i class="icon-trash"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="7" class="text-center">
                            <ul uib-pagination total-items="vm.totalItems" ng-model="vm.currentPage" max-size="vm.maxSize" class="pagination-sm pagination" boundary-links="true" force-ellipses="true" items-per-page="vm.itemsPerPage"></ul>
                        </td>
                    </tr>
                    <tr ng-show="vm.incomeList.length == 0">
                        <td colspan="7">@L("NoRecords")</td>
                    </tr>
                </thead>
            </table>            
        </div>
    </div>
</div>