<div ng-controller="tenant.views.OldList.viewWIPReport as vm">
    <div class="row margin-bottom-5">
        <div class="col-xs-6">
            <div class="page-head">
                <div class="page-title">
                    <h1>
                        <span>@L("WIPReport")</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
    <div class="portlet light margin-bottom-0">
        <div class="portlet-body">
            <form name="report" action="#" class="form-horizontal form-row-sepe ng-pristine ng-valid" busy-if="vm.loadingDate">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("DateRange")
                                </label>
                                <div class="col-md-9">
                                    <input date-range-picker type="text" name="daterange"
                                           options="vm.dateRangeOptions" minDate="vm.dateRangeOptions.minDate" maxDate="vm.dateRangeOptions.maxDate"
                                           class="form-control date-picker input-large" ng-model="vm.dateRangeModel" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group" style="margin-bottom:0px">
                                <label class="col-md-3 control-label">@L("Language")</label>
                                <div class="col-md-9">
                                    <select class="form-control input-small" ng-model="vm.lang" ng-init="vm.lang='EN'" required>
                                        <option value="EN">English</option>
                                        <option value="VN">Vietnamese</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("ClaimRef")
                                </label>
                                <div class="col-md-9">
                                    <input type="text" class="form-control" maxlength="25" ng-model="vm.ClaimID">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group" style="margin-bottom:0px">
                                <label class="control-label col-md-3">
                                    @L("Insurer")
                                </label>
                                <div class="col-md-9">
                                    @*<input type="text" class="form-control" maxlength="100" ng-model="vm.insurer">*@
                                    <select class="form-control"
                                            ng-model="vm.insurer" ng-options="opt.id as opt.name for opt in vm.listInsureres"></select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group" style="margin-bottom:0px">
                                <label class="col-md-3 control-label">@L("TypeOfWIP")</label>
                                <div class="col-md-9">
                                    <div class="mt-radio-inline">
                                        <label class="mt-radio">
                                            <input type="radio" name="optionsRadios1" id="optionsRadios1" value="0" ng-model="vm.rdolisIssued">
                                            WIP1
                                            <span></span>
                                        </label>
                                        <label class="mt-radio">
                                            <input type="radio" name="optionsRadios1" id="optionsRadios1" value="1" ng-model="vm.rdolisIssued">
                                            WIP2
                                            <span></span>
                                        </label>
                                        <label class="mt-radio">
                                            <input checked type="radio" name="optionsRadios1" id="optionsRadios1" value="-1" ng-model="vm.rdolisIssued" ng-checked="!vm.tOW">
                                            ALL
                                            <span></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <div class="row">
                        <div class="col-md-offset-5 col-md-9">
                            <button type="submit" class="btn btn-primary blue" @*ng-disabled="report.$invalid"*@
                                    ng-click=" vm.printReport($event, 'inline')">
                                @L("ViewReport")
                            </button>
                        </div>
                    </div>
                </div>
            </form>
            <br />
           
            <div class="row">
                <div class="col-md-12" style="margin-left:5%">
                    <iframe id="ReportFrame" src="" width="100%" height="1000" style="border:none"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>