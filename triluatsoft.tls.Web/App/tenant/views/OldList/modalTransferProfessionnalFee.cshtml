<div>
    <form name="form" role="form" class="form-validation">
        <div class="panel-group">
            <div class="modal-header">
                <button type="button" class="close" ng-click="vm.cancel()">&times;</button>
                <h3 style="color:#0285bd">@L("TransferProfessionalFee")</h3>
            </div>
            <button type="submit" class="btn btn-primary blue" ng-click="vm.save()" style="margin-top:10px;margin-left:20px;margin-right:3px"><span>@L("Save")</span></button>
            <button type="submit" class="btn btn-primary blue" ng-click="vm.cancel()" style="margin-top:10px;margin-left:3px;margin-right:3px"><span>@L("EditTimesheet")</span></button>
            <div class="modal-body">
             
                    <h4 style="color:#0285bd">@L("TimesheetSummary")</h4>
                    <table id="datatable" class="table table-striped table-bordered table-hover table-checkable dataTable no-footer" cellspacing="0">
                        <thead>
                            <tr>
                                <th class="text-center">@L("ID")</th>
                                <th class="text-center">@L("Timesheet")</th>
                                <th class="text-center">@L("ClaimRef")</th>
                                <th class="text-center">@L("Issue")</th>
                                <th class="text-center">@L("ExUSDVND")</th>
                            </tr>
                            <tr>
                                <td class="text-center">{{vm.ts.timeSheetID}}</td>
                                <td class="text-center">{{vm.ts.timeSheetName}}</td>
                                <td class="text-center">{{vm.ts.claimID}}</td>
                                <td class="text-center"><i class="fa fa-2x" ng-class="vm.ts.isIssued?'fa-check text-success':'fa-ban text-danger'"></i></td>
                                <td class="text-center">{{vm.ts.exchangeRate | number:0}}</td>
                            </tr>
                            <tr>

                        </thead>
                    </table>
                <hr />
                <h4 style="color:#0285bd">@L("ProfessionalFee")</h4>
                <div class="col-md-6" style="padding-bottom:3px">
                    <div class="form-group">
                        <label class="control-label col-md-5">
                            @L("LossAdjusterFilter")
                        </label>
                        <div class="col-md-6">
                            <select class="form-control" ng-options="c.employeeID as c.name for c in vm.assignedList" ng-model="selectedEmployee">
                                <option selected="selected" value="">All</option>                                
                            </select>
                        </div>
                    </div>
                </div>
                <table id="datatable" class="table table-striped table-bordered table-hover table-checkable dataTable no-footer" cellspacing="0">
                    <thead>
                        <tr>
                            <th class="text-center" style="width:100px;">@L("InputDate")</th>
                            <th class="text-center">@L("LossAdjusters")</th>
                            <th class="text-center">@L("Description")</th>
                            <th class="text-center">@L("FeeHour")</th>
                            <th class="text-center">@L("ChargedTime")</th> 
                            <th class="text-center">@L("ChargedLossAdjusters")</th>
                            <th class="text-center">@L("ChargedFeeHour")</th>
                        </tr>
                        <tr ng-repeat="fee in vm.ts.listProFee | filter:{createBy:selectedEmployee === null ? undefined : selectedEmployee}:true">
                            <td class="text-center" width="10%">{{fee.inputDate | date:'dd-MM-yyyy'}}</td>
                            <td class="text-left" width="10%">{{fee.createByName}}</td>
                            <td class="text-left" width="45%">{{fee.notes}}</td>
                            <td class="text-right" width="5%">{{fee.feePerHour}}</td>                            
                            <td class="text-right" width="5%">{{fee.approveTimeStr}}</td>
                            <td class="text-center" width="20%">                                
                                <select class="form-control" ng-options="em.employeeID as em.name for em in vm.assignedList" ng-init="chargeEmployee=fee.chargedBy" ng-model="chargeEmployee" ng-change="vm.changeProfessional(chargeEmployee, fee)"></select>
                            </td>
                            <td class="text-right" width="5%">{{fee.chargedFeePerHour | number:2}}</td>
                        </tr>
                    </thead>
                </table>
                <div class="modal-footer">
                    <button ng-disabled="vm.saving" type="button" class="btn btn-default" ng-click="vm.cancel()">@L("Cancel")</button>
                    <button type="submit" class="btn btn-primary blue" ng-click="vm.save()"><i class="fa fa-save"></i> <span>@L("Save")</span></button>
                    </div>
                </div>
                </div>
</form>
    </div>