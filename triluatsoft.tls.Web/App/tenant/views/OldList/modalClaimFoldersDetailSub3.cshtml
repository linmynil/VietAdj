                <div class="modal-body">
                    <div class="panel panel-default">
                        <table class="table table-striped table-bordered table-hover table-checkable dataTable no-footer" cellspacing="0">
                            <thead role="row">
                                <tr>
                                    <th class="text-center" style="color:blue; font:caption">@L("Name")</th>
                                    <th class="text-center" style="color:blue; font:caption">@L("Size")</th>
                                    <th class="text-center" style="color:blue; font:caption">@L("Type")</th>
                                    <th class="text-center" style="color:blue; font:caption">@L("LastAccessed")</th>
                                    <th class="text-center" style="color:blue; font:caption">@L("LastModified")</th>
                                    <th class="text-center" style="color:blue; font:caption">@L("Action")</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="folder in vm.list.folderList">
                                    <td class="text-left  col-md-4" style="text-overflow:ellipsis;"><a ng-click="vm.openModalClaimFolder(folder.fName)">{{ folder.fName}}</a></td>
                                    <td class="text-right col-md-1"></td>
                                    <td class="text-right col-md-1"></td>
                                    <td class="text-center col-md-2">{{folder.creationTime | date:'HH:mm dd-MM-yyyy':'UTC'}}</td>
                                    <td class="text-center col-md-2">{{folder.lastAccessTime | date:'HH:mm dd-MM-yyyy':'UTC'}}</td>
                                    <td class="text-center"></td>
                                </tr>
                                <tr ng-repeat="file in vm.list.fileList">
                                    <td class="text-left  col-md-4" style="text-overflow:ellipsis;"><a ng-click="vm.openModalClaimFolder(file.fName)">{{ file.fName}}</a></td>
                                    <td class="text-right col-md-1">{{file.length}}</td>
                                    <td class="text-right col-md-1">{{file.extension}}</td>
                                    <td class="text-center col-md-2">{{file.creationTime | date:'HH:mm dd-MM-yyyy':'UTC'}}</td>
                                    <td class="text-center col-md-2">{{file.lastAccessTime | date:'HH:mm dd-MM-yyyy':'UTC'}}</td>
                                    <td class="text-center"></td>
                                </tr>
                                <tr ng-show="vm.list.folderList.length + vm.list.fileList.length == 0">
                                    <td colspan="15">@L("NoRecords")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            </div>

            <div class="modal-footer">
                <button ng-disabled="vm.saving" type="button" class="btn btn-default" ng-click="vm.cancel()">@L("Cancel")</button>
            </div>
        </form>
    </div>