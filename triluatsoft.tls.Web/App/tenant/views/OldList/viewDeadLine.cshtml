<div ng-controller="tenant.views.OldList.viewDeadLine as vm">
    <div class="row margin-bottom-5">
        <div class="col-xs-6">
            <div class="page-head">
                <div class="page-title">
                    <h1>
                        <span>@L("ManageDeadline")</span>
                    </h1>
                </div>
            </div>
        </div>
        <div class="col-xs-6 text-right">
            <button class="btn btn-primary blue" id="createbnt" ng-click="vm.openModal()"><i class="fa fa-plus"></i>@L("Create")</button>
        </div>
    </div>
    <div class="portlet light margin-bottom-0">
        <div class="portlet-body">
            <form action="#" class="form-horizontal form-row-sepe ng-pristine ng-valid">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("From")
                                </label>
                                <div class="col-md-4">
                                    <input type="text" name="from" id="from" class="form-control input-large" placeholder="dd/mm/yyyy" ng-model="vm.from">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("To")
                                </label>
                                <div class="col-md-4">
                                    <input type="text" name="to" id="to" class="form-control input-large" placeholder="dd/mm/yyyy" ng-model="vm.to">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("Name")
                                </label>
                                <div class="col-md-4">
                                    <input type="text" class="form-control input-large" ng-model="vm.searchdata.taskName" maxlength="100">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("ClaimRef")
                                </label>
                                <div class="col-md-4">
                                    <input type="text" class="form-control input-large" ng-model="vm.searchdata.claimID" maxlength="25">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("Type")
                                </label>
                                <div class="col-md-4">
                                    <select class="form-control input-large"
                                            ng-model="vm.searchdata.type">
                                        <option selected="selected" value="">All</option>
                                        <option value="1">Assigned by</option>
                                        <option value="2">Assigned to</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("Status")
                                </label>
                                <div class="col-md-4">
                                    <select class="form-control input-large"
                                            ng-model="vm.searchdata.status">
                                        <option selected="selected" value="">All</option>
                                        <option value="1">Completed</option>
                                        <option value="2">In progress</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <div class="row">
                        <div class="col-md-offset-5 col-md-9">
                            <button type="submit" ng-disabled="vm.loading || !vm.grant_search" class="btn btn-primary blue" ng-click="vm.search($event)">
                                @L("Search")
                            </button>
                            <button type="reset" class="btn btn-primary blue" ng-click="vm.reset()">
                                @L("Reset")
                            </button>
                        </div>
                    </div>
                </div>
            </form>
            <br />
            <table class="table table-striped table-bordered table-hover no-footer" busy-if="vm.loading" data-click-to-select="true">
                <thead role="row">
                    <tr>
                        <th class="text-center" width="8%">@L("ClaimRef")</th>
                        <th class="text-center" width="30%">@L("Description")</th>
                        <th class="text-center" width="9%">@L("Assignedby")</th>
                        <th class="text-center" width="9%">@L("Assignedto")</th>
                        <th class="text-center" width="11%">@L("Date")</th>
                        <th class="text-center" width="11%">@L("Deadline")</th>
                        <th class="text-center" width="10%">@L("Status")</th>
                        <th class="text-center" width="12%">@L("Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="item in vm.list">

                        <td class="text-center" ng-class="item.isMissed == true ? 'text-danger bold' : ''" width="8%">{{item.claimID}}</td>
                        <td class="text-left" ng-class="item.isMissed == true ? 'text-danger bold' : ''" width="30%">{{item.taskName}}</td>
                        <td class="text-center" ng-class="item.isMissed == true ? 'text-danger bold' : ''" width="9%">{{item.createdUser}}</td>
                        <td class="text-center" ng-class="item.isMissed == true ? 'text-danger bold' : ''" width="9%">{{item.assignee}}</td>
                        <td class="text-center" ng-class="item.isMissed == true ? 'text-danger bold' : ''" width="11%">{{item.startDate | date:'HH:mm dd-MM-yyyy':'UTC'}}</td>
                        <td class="text-center" ng-class="item.isMissed == true ? 'text-danger bold' : ''" width="11%">{{item.endDate | date:'HH:mm dd-MM-yyyy':'UTC'}}</td>
                        <td class="text-center" ng-class="item.isMissed == true ? 'text-danger bold' : ''" width="10%">
                            <span ng-show="item.isCompleted">Completed</span>
                            <span ng-show="!item.isCompleted">In progress</span>
                        </td>
                        <td class="text-center" ng-class="item.isMissed == true ? 'text-danger bold' : ''" width="12%">
                            <button ng-click="vm.openModal(item)" ng-disabled="!vm.grant_edit" title="@L("Edit")" class="btn btn-circle btn-icon-only blue" href="javascript:;" style="margin-left:0px">
                                <i class="icon-pencil"></i>
                            </button>
                            <button ng-click="vm.delete(item.id)" ng-disabled="!vm.grant_delete" title="@L("Delete")" class="btn btn-circle btn-icon-only red" href="javascript:;">
                                <i class="icon-trash"></i>
                            </button>
                        </td>
                    </tr>
                    <tr ng-show="vm.list.length == 0">
                        <td colspan="15">@L("NoRecords")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>