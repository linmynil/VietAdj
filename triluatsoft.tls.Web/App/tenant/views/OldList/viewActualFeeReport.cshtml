<div ng-controller="tenant.views.OldList.viewActualFeeReport as vm">
    <div class="row margin-bottom-5">
        <div class="col-xs-6">
            <div class="page-head">
                <div class="page-title">
                    <h1>
                        <span>@L("ActualFeeReport")</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
    <div class="portlet light margin-bottom-0">
        <div class="portlet-body">
            <form name="report" action="#" class="form-horizontal form-row-sepe ng-pristine ng-valid" busy-if="vm.loadingDate">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group" ng-class="{ 'has-error' : report.fdate.$invalid}">
                                <label class="control-label col-md-4">
                                    @L("DateRange")
                                </label>
                                <div class="col-md-8">
                                    <input name="fdate" date-range-picker type="text" options="vm.dateRangeOptions" min="vm.dateRangeOptions.min" max="vm.dateRangeOptions.max" class="form-control date-picker" ng-model="vm.dateRangeModel" id="dataRange" required />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group" style="margin-bottom:0px">
                                <label class="col-md-3 control-label">@L("Language")</label>
                                <div class="col-md-9">
                                    <select class="form-control input-small" ng-model="vm.lang" ng-init="vm.lang='EN'" required>
                                        <option value="EN">English</option>
                                        <option value="VN">Vietnamese</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group" style="margin-bottom:0px">
                                <label class="col-md-3 control-label">@L("Employee")</label>
                                <div class="col-md-9">
                                    <select class="form-control" ng-model="vm.empId" ng-options="emp.employeeId as emp.name for emp in vm.listEmployees">
                                        <option selected value="">All</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-9">
                            <label class="col-md-2 control-label">Type Of Issue:</label>
                            <div class="col-md-7">
                                <div class="mt-radio-inline">
                                    <label class="mt-radio">
                                        <input type="radio" name="optionsRadios1" id="optionsRadios1" value="0" ng-model="vm.rdolisIssued">
                                        Not Issued
                                        <span></span>
                                    </label>
                                    <label class="mt-radio">
                                        <input type="radio" name="optionsRadios1" id="optionsRadios1" value="1" ng-model="vm.rdolisIssued">
                                        Issued
                                        <span></span>
                                    </label>
                                    <label class="mt-radio">
                                        <input checked type="radio" name="optionsRadios1" id="optionsRadios1" value="-1" ng-model="vm.rdolisIssued" ng-checked="vm.rdolisIssued==-1">
                                        ALL
                                        <span></span>
                                    </label>
                                </div>
                            </div>
                        </div>                        
                    </div>
                </div>

                <div class="form-actions">
                    <div class="row">
                        <div class="col-md-offset-5 col-md-9">
                            <button type="submit" class="btn btn-primary blue" ng-disabled="report.$invalid"
                                    ng-click="vm.printReport($event, 'inline')">
                                @L("ViewReport")
                            </button>
                        </div>
                    </div>
                </div>
            </form>
            <br />
            <div class="row">
                <div class="col-md-12" style="margin-left:5%">
                    <iframe id="ReportFrame" src="" width="100%" height="1000" style="border:none"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>