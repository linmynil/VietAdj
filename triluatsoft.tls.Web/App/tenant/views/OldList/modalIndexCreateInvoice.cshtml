<div>
    <form name="form" role="form" class="form-validation">
        <div class="panel-group">
            <div class="modal-header">
                <button type="button" class="close" ng-click="vm.cancel()">&times;</button>
                <h3 style="color:#0285bd">@L("CreateInvoice")</h3>
            </div>
            <div class="modal-body" busy-if="vm.loading">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group" ng-class="{ 'has-error' : form.claimID.$invalid}">
                            <label class="control-label col-md-3">
                                @L("ClaimRef")
                            </label>
                            <div class="col-md-9">
                                <select class="form-control" required name="claimID"
                                        ng-model="vm.claimID"
                                        ng-options="x for x in vm.listClaims"
                                        ng-change="vm.selectClaim()">
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group" ng-class="{ 'has-error' : form.customerID.$invalid}">
                            <label class="control-label col-md-3">
                                @L("Insurer")
                            </label>
                            <div class="col-md-9">
                                <select class="form-control" required name="customerID"
                                        ng-model="vm.customerID"
                                        ng-options="x.customerID as x.customerName for x in vm.listCustomers"
                                        ng-change="vm.selectCustomer()">
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="padding-top:40px">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="text-center">
                                <button type="button" class="btn btn-default" ng-click="vm.cancel()">@L("Cancel")</button>
                                <button type="submit" ng-disabled="vm.loading || form.$invalid" class="btn btn-primary blue" ng-click="vm.openModalInterim()">
                                    @L("Interim")
                                </button>
                                <button type="submit" ng-disabled="vm.loading || form.$invalid" class="btn btn-primary blue" ng-click="vm.openModalFinal()">
                                    @L("Final")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </form>
    </div>