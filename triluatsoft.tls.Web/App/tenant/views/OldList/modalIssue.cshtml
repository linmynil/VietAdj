<div>
    <form name="form" role="form" class="form-validation">
        <div class="panel-group">
            <div class="modal-header">
                <button type="button" class="close" ng-click="vm.cancel()">&times;</button>
                <h3 style="color:#0285bd">@L("IssueTimesheet") {{vm.timesheetName}}</h3>
            </div>
            <div class="modal-body">
              
                <div class="row" style="margin-bottom:5px">
                    <div class="col-md-6">
                        <div class="form-group"  ng-class="{ 'has-error' : form.issueDate.$invalid}">
                            <label class="control-label col-md-4" style="width:150px">
                                @L("Date")
                            </label>
                            <div class="col-md-4">
                                <input type="text" name="issueDate" class="form-control input-large" ng-model="vm.item.issueDate" required>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-default" ng-click="vm.cancel()">@L("Cancel")</button>
                <button ng-disabled="vm.saving || form.$invalid" type="submit" class="btn btn-primary blue" ng-click="vm.save()"><i class="fa fa-save"></i> <span>@L("Save")</span></button>
          
            </div>
        </form>
    </div>