<div>
    <form name="form" role="form" class="form-validation">
        <div class="panel-group">
            <div class="modal-header">
                <button type="button" class="close" ng-click="vm.cancel()">&times;</button>
                <h3 style="color:#0285bd">@L("InvoiceDetails")</h3>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-3">
                                @L("ClaimRef")
                            </label>
                            <div class="col-md-9">
                               <label>{{vm.item.claimID}}</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-3">
                                @L("Insurer")
                            </label>
                            <div class="col-md-9">
                                <label>{{vm.item.customer.customerName}}</label>
                            </div>
                           
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-3">
                                @L("InvoiceNo")
                            </label>
                            <div class="col-md-9">
                                <label>{{vm.item.invoiceCode}}</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-3">
                                @L("Address")
                            </label>
                            <label class="control-label col-md-8">
                                {{vm.item.customer.address}}
                            </label>
                            
                        </div>
                    </div>
                </div>
                <table class="table table-striped table-bordered table-hover no-footer" busy-if="vm.loading" data-click-to-select="true">
                    <thead role="row">
                        <tr>
                            <th class="text-center">@L("IncurredFee")</th>
                            <th class="text-center">@L("Discount")</th>
                            <th class="text-center">@L("Fee")</th>
                            <th class="text-center">@L("Expense")</th>
                            <th class="text-center">@L("Subtotal")</th>
                            <th class="text-center">@L("VAT")</th>
                            <th class="text-center">@L("Total")</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-left">{{vm.item.proFeeAMT | number: 0}}</td>
                            <td class="text-center">{{vm.item.discountAMT | number: 0}}</td>
                            <td class="text-right">{{vm.item.proFeeGrandAMT | number: 0}}</td>
                            <td class="text-right">{{vm.item.expenseAMT | number: 0}}</td>
                            <td class="text-right">{{vm.item.revenueAMT | number: 0}}</td>
                            <td class="text-right">{{vm.item.taxAMT | number: 0}}</td>
                            <td class="text-right">{{vm.item.totalAMT | number: 0}}</td>
                        </tr>
                    </tbody>
                </table>
                </div>
            </div>
            <div class="modal-footer">
                <button ng-disabled="vm.saving" type="button" class="btn btn-default" ng-click="vm.cancel()">@L("Close")</button>
               
            </div>
        </form>
    </div>