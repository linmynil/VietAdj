                            <thead role="row">
                                <tr>
                                    <th class="text-center" style="color:blue; font:caption">Name</th>
                                    <th class="text-center" style="color:blue; font:caption">Size</th>
                                    <th class="text-center" style="color:blue; font:caption">Type</th>
