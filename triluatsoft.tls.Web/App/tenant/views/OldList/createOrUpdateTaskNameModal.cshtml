<div>
    <form name="exampleForm" role="form" novalidate class="form-validation">
        <div class="modal-header">
            <button type="button" class="close" ng-click="vm.cancel()">&times;</button>
            <h4 class="modal-title">
                <span ng-if="vm.item.id">Edit</span>
                <span ng-if="!vm.item.id">Create</span>
            </h4>
        </div>
        <div class="modal-body">
            <div class="form-group form-md-line-input form-md-floating-label no-hint">
                <input class="form-control" ng-class="{'edited':vm.item.jobCode}" type="text" name="JobCode" ng-model="vm.item.jobCode" required maxlength="10">
                <label>Job Code</label>
            </div>
            <div class="form-group form-md-line-input form-md-floating-label no-hint">
                <input class="form-control" ng-class="{'edited':vm.item.name}" type="text" name="Name" ng-model="vm.item.name" required maxlength="100">
                <label>Task Name</label>
            </div>
            <div class="form-group form-md-line-input form-md-floating-label no-hint">
                <input class="form-control" ng-class="{'edited':vm.item.standardTime}" type="text" name="StandardTime" ng-model="vm.item.standardTime" required value="{{vm.item.standardTime | number: 2}}">
                <label>Standard Time</label>
            </div>
        </div>
        <div class="modal-footer">
            <button ng-disabled="vm.saving" type="button" class="btn btn-default" ng-click="vm.cancel()">@L("Cancel")</button>
            <button type="submit" button-busy="vm.saving" busy-text="@L("SavingWithThreeDot")" class="btn btn-primary blue" ng-click="vm.save()" ng-disabled="exampleForm.$invalid"><i class="fa fa-save"></i> <span>@L("Save")</span></button>
        </div>
    </form>
</div>