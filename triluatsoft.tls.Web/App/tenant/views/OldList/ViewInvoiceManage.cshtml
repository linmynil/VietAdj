<div ng-controller="tenant.views.OldList.viewInvoiceManage as vm">
    <div class="row margin-bottom-5">
        <div class="col-xs-6">
            <div class="page-head">
                <div class="page-title">
                    <h1>
                        <span>@L("ManageInvoice")</span>
                    </h1>
                </div>
            </div>
        </div>
        <div class="col-xs-6 text-right">
            <button class="btn btn-primary blue" ng-click="vm.openModalCreateInvoice()" ng-disabled="!vm.grant_create"><i class="fa fa-plus"></i>@L("Create")</button>
        </div>
    </div>
    <div class="portlet light margin-bottom-0">
        <div class="portlet-body">
            <form action="#" class="form-horizontal form-row-sepe ng-pristine ng-valid" busy-if="vm.loadingDate">
                <div class="form-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("DateRange")
                                </label>
                                <div class="col-md-4">
                                    <input date-range-picker type="text" options="vm.dateRangeOptions" 
                                           min="vm.dateRangeOptions.min" max="vm.dateRangeOptions.max" 
                                           class="form-control date-picker input-large" ng-model="vm.dateRangeModel"/>
                                
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("ClaimRef")
                                </label>
                                <div class="col-md-4">
                                    <input type="text" class="form-control input-large" ng-model="vm.searchdata.claimID" maxlength="20">
                                </div>
                            </div>
                            </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("InvoiceNo")
                                </label>
                                <div class="col-md-4">
                                    <input type="text" class="form-control input-large" ng-model="vm.searchdata.invoiceCode" maxlength="20">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label col-md-3">
                                    @L("Insurer")
                                </label>
                                <div class="col-md-4">
                                    <select class="form-control input-large"
                                            ng-model="vm.searchdata.insurerID" ng-options="opt.id as opt.name for opt in vm.listInsureres">
                                        <option selected value="">All</option>
                                    </select>
                                </div>
                            </div>
                            </div>
                    </div>
                </div>
                
                <div class="form-actions">
                    <div class="row">
                        <div class="col-md-offset-5 col-md-9">
                            <button type="submit" ng-disabled="vm.loading" class="btn btn-primary blue" ng-click="vm.searchLogs($event)">
                                @L("Search")
                            </button>
                            <button type="reset" class="btn btn-primary blue" ng-click="vm.reset()">
                                @L("Reset")
                            </button>
                        </div>
                    </div>
                </div>
            </form>
            <br />
            <table class="table table-striped table-bordered table-hover no-footer" busy-if="vm.loading" data-click-to-select="true">
                <thead role="row">
                    <tr>
                        <th class="text-center">@L("InvoiceNo")</th>
                        <th class="text-center">@L("InvoiceDate")</th>
                        <th class="text-center">@L("ClaimRef")</th>
                        <th class="text-center">@L("Insurer")</th>
                        <th class="text-center">@L("Fee")</th>
                        <th class="text-center">@L("Expenses")</th>
                        <th class="text-center">@L("VAT")</th>
                        <th class="text-center">@L("Total")</th>
                        <th class="text-center">@L("Note")</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="item in vm.list">
                        <td class="text-right"><a ng-click="vm.openModalDetailInvoiceNo(item.invoiceID)">{{item.invoiceCode}}</a></td>
                        <td class="text-center">{{item.invoiceDate | date: 'dd-MM-yyyy'}}</td>
                        <td class="text-left">{{item.claimID}}</td>
                        <td class="text-left">{{item.customerBrandName}}</td>
                        <td class="text-right">{{item.proFeeGrandAMT|number:0}}</td>
                        <td class="text-right">{{item.expenseAMT | number:0}}</td>
                        <td class="text-right">{{item.taxAMT | number:0}}</td>
                        <td class="text-right">{{item.totalAMT | number:0}}</td>
                        <td class="text-left">{{item.note}}</td>
                    </tr>
                    <tr ng-show="vm.list.length == 0">
                        <td colspan="15">@L("NoRecords")</td>
                    </tr>
                </tbody>
            </table>
            <div class="row">
                <div class="col-md-7">
                    <ul boundary-link-numbers="true" class="margin-top-0" uib-pagination total-items="vm.totalCount" items-per-page="20" ng-model="vm.page" ng-change="vm.pageChanged()" max-size="5"></ul>
                </div>
            </div>
        </div>
    </div>
</div>