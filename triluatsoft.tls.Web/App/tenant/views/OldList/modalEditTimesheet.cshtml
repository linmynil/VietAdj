<div>
    <form name="form" role="form" class="form-validation">
        <div class="panel-group">
            <div class="modal-header">
                <button type="button" class="close" ng-click="vm.cancel()">&times;</button>
                <div>
                    <h3 class="form-group" style="color:#0285bd">@L("EditTimesheet") {{ vm.timesheet.timeSheetName}}</h3>
                </div>
                <button type="submit" class="btn btn-primary blue" ng-disabled="vm.timesheet.isIssued || form.exchangeRateV.$invalid || vm.loading" ng-click="vm.save()"> <span>@L("Save")</span></button>
                <button type="submit" class="btn btn-primary blue" ng-disabled="vm.timesheet.isIssued || !vm.grant_transfer" ng-click="vm.openModalTransferTimesheet(vm.timesheet)"> <span>@L("Transfer")</span></button>
                <button type="submit" class="btn btn-primary blue" ng-disabled="vm.timesheet.isIssued || !vm.grant_issue" ng-click="vm.openModalIssue(vm.timesheet.timeSheetID, vm.timesheet.timeSheetName)"> <span>@L("Issue")</span></button>
                <button type="submit" class="btn btn-primary blue" ng-disabled="!vm.timesheet.isIssued || vm.timesheet.isInvoiced || !vm.grant_issue" ng-click="vm.unissue(vm.timesheet.timeSheetID)"> <span>@L("UnIssue")</span></button>
                <button type="submit" class="btn btn-primary blue" ng-disabled="!vm.timesheet.isIssued || vm.timesheet.isInvoiced || !vm.grant_invoice" ng-click="vm.openModalCreateInvoice(vm.timesheet.claimID)"> <span>@L("Invoice")</span></button>
                <button type="submit" class="btn btn-primary blue" ng-disabled="vm.timesheet.isIssued || vm.timesheet.isSubmited || !vm.grant_submit" ng-click="vm.isSubmit(vm.timesheet.timeSheetID)"> <span>@L("Submit")</span></button>
                <button type="submit" class="btn btn-primary blue" ng-disabled="vm.timesheet.isIssued || !vm.timesheet.isSubmited || !vm.grant_submit" ng-click="vm.unSubmit(vm.timesheet.timeSheetID)"> <span>@L("UnSubmit")</span></button>

            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group" ng-class="{ 'has-error' : form.exchangeRateV.$invalid}">
                            <label class="control-label col-md-4" style="padding-top:0">@L("ExchangeRateUSDVND")</label>
                            <input class="form-control input-small" name="exchangeRateV" type="text" ng-readonly="vm.timesheet.isIssued" ng-model="vm.currentEx" ng-change="vm.changeRateExchange()" required sg-number-input>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label col-md-4" style="padding-top:0">@L("DiscountValue")</label>
                            <div class="col-md-8 input-group">
                                <input class="form-control col-md-9 input-small text-right" style="width:auto" type="text" name="discount"
                                       ng-model="vm.currentDis" ng-readonly="vm.timesheet.isIssued" @*ng-pattern="/^[0-9]+(\.[0-9]{1,2})?$/" step="0.01"*@ ng-change="vm.discountChange()" sg-number-input>
                                <div class="input-group-append col-md-2">
                                    <button id="ExpButton" type="button" class="btn btn-outline-secondary dropdown-toggle" data-toggle="dropdown">
                                        Percent <span class="caret"></span>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-right" ng-model="vm.timesheet.discountType">
                                        <li><a href="#" ng-click="vm.setExpType('P');">Percent</a></li>
                                        <li><a href="#" ng-click="vm.setExpType('A');">Amount</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <h4 style="color:#0285bd">@L("TimesheetSummary")</h4>
                <table id="datatable" class="table table-striped table-bordered table-hover table-checkable dataTable no-footer" cellspacing="0">
                    <thead>
                        <tr>
                            <th class="text-center">@L("ID")</th>
                            <th class="text-center">@L("ClaimRef")</th>
                            <th class="text-center">@L("Issue")</th>
                            <th class="text-center">@L("Invoice")</th>
                            <th class="text-center">@L("ActualFee")</th>
                            <th class="text-center">@L("IncurredFee")</th>
                            <th class="text-center">@L("Discount")</th>
                            <th class="text-center">@L("Fee")</th>
                            <th class="text-center">@L("Expenses")</th>
                            <th class="text-center">@L("VAT")</th>
                            <th class="text-center">@L("Total")</th>
                        </tr>
                    </thead>
                        <tr>
                            <td class="text-right">{{vm.timesheet.timeSheetID}}</td>
                            <td class="text-left">{{vm.timesheet.claimID}}</td>
                            <td class="text-center"><i class="fa fa-2x" ng-class="vm.timesheet.isIssued?'fa-check text-success':'fa-ban text-danger'"></i></td>
                            <td class="text-right">{{vm.timesheet.invoiceCode }}</td>
                            <td class="text-right">{{vm.timesheet.actualFeeVND | number:0}}</td>
                            <td class="text-right">{{vm.timesheet.proFeeAMTVND | number:0}}</td>
                            <td class="text-right">{{vm.timesheet.discountAMT | number:0}}</td>
                            <td class="text-right">{{vm.timesheet.proFeeGrandAMT | number:0}}</td>
                            <td class="text-right">{{vm.timesheet.expenseAMT | number:0}}</td>
                            <td class="text-right">{{vm.timesheet.taxAMT | number:0}}</td>
                            <td class="text-right">{{vm.timesheet.grandAMT | number:0}}</td>
                        </tr>


                </table>
                <uib-tabset class="tab-container tabbable-line">
                    <uib-tabset class="tab-container tabbable-line">
                        <uib-tab heading="@L("IncurredFee")">
                            <div class="row" style="padding-top:8px;padding-bottom:8px">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label col-md-5">
                                            @L("LossAdjusterFilter"):
                                        </label>
                                        <div class="col-md-7">
                                            <select class="form-control" ng-options="c.employeeID as c.name for c in vm.assignedList" ng-model="selectedEmployee" ng-change="vm.changeSelectedEmployee(selectedEmployee)">
                                                <option selected="selected" value="">All</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <table id="datatable" class="table table-striped table-bordered table-hover table-checkable dataTable no-footer" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th class="text-center col-md-2">@L("Date")</th>
                                        <th class="text-center col-md-2">@L("LossAdjusters")</th>
                                        <th class="text-center">@L("Description")</th>
                                        <th class="text-center">@L("RateUSD")</th>
                                        <th class="text-center">@L("StandardTime")</th>
                                        <th class="text-center">@L("ActualTime")</th>
                                        <th class="text-center">@L("ApprovedTime")</th>
                                        <th class="text-center">@L("IncurredFeeUSD")</th>
                                    </tr>
                                    <tr ng-repeat="fee in vm.timesheet.listProFee | filter:{createBy:selectedEmployee === null ? undefined : selectedEmployee}:true" >
                                        <td class="text-center">{{fee.inputDate | date:'dd-MM-yyyy'}}</td>
                                        <td class="text-left">{{fee.chargedByName}}</td>
                                        <td class="text-left">{{fee.notes}}</td>
                                        <td class="text-right">{{fee.chargedFeePerHour}}</td>
                                        <td class="text-right">{{fee.standardTime | number: 1}}</td>
                                        <td class="text-right">{{fee.workTimeStr}}</td>                                                                                
                                        <td class="text-right">
                                            <input type="text" class="text-center ng-pristine ng-valid" size="5" ng-disabled="vm.timesheet.isIssued || !vm.isAdmin"
                                                   name="approveTime" ng-model="fee.approveTimeStr" required
                                                   ui-mask="99:99" 
                                                   ui-mask-placeholder="__:__"
                                                   @*ui-mask-placeholder-char="_"*@
                                                   ng-change="vm.OnchangeApproveTime(fee)">
                                        </td>                                        
                                        <td class="text-right">{{fee.chargedProFeeValue | number:2}}</td>
                                    </tr>

                                </thead>
                            </table>
                        </uib-tab>
                        <uib-tab>
                            <uib-tab-heading>
                                @L("Expenses") <b class="badge badge-primary"></b>
                            </uib-tab-heading>
                            <table id="datatable" class="table table-striped table-bordered table-hover table-checkable dataTable no-footer" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th class="text-center col-md-2">@L("Date")</th>
                                        <th class="text-center">@L("Description")</th>
                                        <th class="text-center">@L("TypeOfExpenses")</th>
                                        <th class="text-center">@L("Amount")</th>
                                    </tr>
                                    <tr ng-repeat="exp in vm.timesheet.listExpense" *@>
                                        <td class="text-center">{{exp.inputDate | date:'dd-MM-yyyy'}}</td>
                                        <td class="text-left">{{exp.description}}</td>
                                        <td class="text-left">{{exp.expenseTypeName}}</td>
                                        <td class="text-right">{{exp.amount | number:0}}</td>
                                    </tr>
                                </thead>
                            </table>
                        </uib-tab>
                    </uib-tabset>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-default" ng-click="vm.cancel()">@L("Cancel")</button>
            </div>
        </form>
    </div>