<div>
    <form name="form" role="form" class="form-validation">
        <div class="panel-group">
            <div class="modal-header">
                <button type="button" class="close" ng-click="vm.cancel()">&times;</button>
                <h3 style="color:#0285bd">@L("AddModifyTimesheet")</h3>
            </div>
            <div class="modal-body">
                <div class="row" style="margin-bottom:5px">
                    <div class="col-md-6">
                        <div class="form-group"  ng-class="{ 'has-error' : form.claimId.$invalid }">
                            <label class="control-label col-md-4" style="width:150px">
                                @L("ClaimRef")
                            </label>
                            <div class="col-md-4">
                                <select class="form-control input-large" name="claimId" ng-options="item for item in vm.list" required ng-model="vm.item.claimID" ng-change="vm.selectClaim(vm.item.claimID)">
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-bottom:5px">
                    <div class="col-md-6">
                        <div class="form-group" >
                            <label class="control-label col-md-4" style="width:150px">
                                @L("TimesheetName")
                            </label>
                            <div class="col-md-4">
                                <input type="text" class="form-control input-large" ng-model="vm.item.timeSheetName" readonly>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-bottom:5px">
                    <div class="col-md-6">
                        <div class="form-group"  ng-class="{ 'has-error' : form.exchangeRate.$invalid }">
                            <label class="control-label col-md-4" style="width:150px">
                                @L("ExchangeRate")
                            </label>
                            <div class="col-md-4">
                                <input type="text" class="form-control input-large text-right" required sg-number-input
                                       name="exchangeRate" ng-model="vm.item.exchangeRate" maxlength="18">
                            </div>
                        </div>
                    </div>
                </div>

              
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-default" ng-click="vm.cancel()">@L("Cancel")</button>
                <button type="submit" class="btn btn-primary blue" ng-click="vm.save()" ng-disabled="vm.saving || form.$invalid" ><i class="fa fa-save"></i> <span>@L("Save")</span></button>
          
            </div>
        </form>
    </div>