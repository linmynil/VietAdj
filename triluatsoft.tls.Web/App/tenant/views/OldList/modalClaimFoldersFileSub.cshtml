                            </thead>
                            <tbody>
                                <tr ng-repeat="cause in vm.list">
                                    <td class="text-left col-md-4" style="text-overflow:ellipsis;">{{cause.fName}}</td>
                                    <td class="text-right col-md-1">{{cause.length}}</td>
                                    <td class="text-right col-md-1">{{cause.extension}}</td>
                                    <td class="text-center col-md-2">{{cause.creationTime | date:'HH:mm dd-MM-yyyy':'UTC'}}</td>
